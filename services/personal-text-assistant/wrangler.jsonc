{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nk-personal-text-assistant",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "vars": {
    "ALLOW_PAID_AI": "false",
    "ALLOW_OUTBOUND_SEND": "false",
    "AUTO_REPLY_ENABLED": "false",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATIONS", "class_name": "TextConversation" }
    ]
  },
  "exports": {
    "TextConversation": { "type": "durable-object", "storage": "sqlite" }
  }
}
