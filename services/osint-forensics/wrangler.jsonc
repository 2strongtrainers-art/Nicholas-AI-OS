{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "argus-prime-forensics",
  "main": "edge/index.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "containers": [
    {
      "class_name": "ForensicInstance",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FORENSIC_CONTAINER",
        "class_name": "ForensicInstance"
      }
    ]
  },
  "exports": {
    "ForensicInstance": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": false
  }
}
