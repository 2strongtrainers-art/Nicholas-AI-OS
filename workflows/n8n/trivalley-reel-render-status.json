      "id": "931fa48a-c8c9-4718-8de1-b580a02ff062",
      "name": "Read render runs from GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        100
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const runs = $input.first().json.workflow_runs;\nif (!Array.isArray(runs)) throw new Error('GitHub did not return a workflow run list.');\n\nconst repository = 'https://github.com/2strongtrainers-art/Nicholas-AI-OS';\nconst privateEpisode = /^(?:elite-assessment-pilot|show-me-one-rep-\\d{4}-\\d{2}-\\d{2})$/;\nconst conclusions = new Set(['success', 'failure', 'cancelled', 'timed_out', 'action_required',\n  'skipped', 'stale', 'neutral', 'startup_failure']);\nconst receipts = new Map();\n\nfor (const run of runs) {\n  if (run.workflow_id !== 416944064 || run.path !== '.github/workflows/render-trivalley-reel.yml' ||\n      run.event !== 'workflow_dispatch' || run.head_branch !== 'main' ||\n      run.status !== 'completed' || !conclusions.has(run.conclusion)) continue;\n  if (!Number.isSafeInteger(run.id) || run.id < 1 ||\n      !Number.isSafeInteger(run.run_attempt) || run.run_attempt < 1) continue;\n  const title = /^TriValley Reel \\| ([a-z0-9-]+) \\| (private|synthetic)$/.exec(run.display_title);\n  if (!title) continue;\n  const [, episode, source] = title;\n  if (source === 'synthetic' ? episode !== 'reel-smoke-test' : !privateEpisode.test(episode)) continue;\n\n  const version = run.id + '-' + run.run_attempt;\n  let receipt = '';\n  if (run.conclusion === 'success') {\n    receipt = source === 'synthetic'\n      ? 'GitHub artifact reel-smoke-test-' + version\n      : 'reels/review/' + episode + '/' + version + '/' + episode + '.mp4';\n  }\n  receipts.set(version, { json: {\n    episode_id: episode, media_source: source, render_status: run.conclusion,\n    run_url: repository + '/actions/runs/' + run.id + '/attempts/' + run.run_attempt,\n    receipt, run_version: version,\n  } });\n}\n\nreturn [...receipts.values()];"
      },
      "id": "58d084cb-cd2d-42db-a347-88298054e525",
      "name": "Prepare one receipt per completed attempt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        510,
        100
      ]
    },
