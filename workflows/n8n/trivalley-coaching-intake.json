{
  "name": "TriValley Wix Coaching Intake | Review",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trivalley-coaching-intake",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Receive staging inquiry",
      "id": "0068f00b-3fa8-4635-a735-886c004038d9",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json.body;\nconst reply = (httpStatus, body) => [{ json: { httpStatus, body } }];\n\nif (!payload || typeof payload !== \"object\" || Array.isArray(payload)) {\n  return reply(400, { status: \"invalid-intake\", field: \"body\" });\n}\nconst allowedFields = new Set([\"id\", \"service\", \"contactPermission\"]);\nif (Object.keys(payload).some(key => !allowedFields.has(key))) {\n  return reply(400, { status: \"invalid-intake\", field: \"unexpected-field\" });\n}\nconst { id, service, contactPermission } = payload;\nif (typeof id !== \"string\" || !/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/i.test(id)) {\n  return reply(400, { status: \"invalid-intake\", field: \"id\" });\n}\nif (service !== \"coaching\") {\n  return reply(400, { status: \"invalid-intake\", field: \"service\" });\n}\n\nconst inquiryId = id.toLowerCase();\nif (contactPermission !== true) {\n  return reply(200, { id: inquiryId, status: \"hold-for-consent\" });\n}\nreturn reply(200, {\n  id: inquiryId,\n  status: \"draft-for-review\",\n  draft: {\n    subject: \"Your TriValley.fit coaching application\",\n    body: \"Hi there, thanks for applying for TriValley.fit coaching. What would you most like to accomplish in the next four weeks, and what time of day works best for a short intro call? — Nick, TriValley.fit\"\n  }\n});"
      },
