# NEVER commit real values. Store production secrets in GitHub Actions/Dify secret stores.

# Global safety gates
ALLOW_PAID_AI=false
ALLOW_APOLLO_CREDIT_SPEND=false
ALLOW_OUTBOUND_SEND=false

# HubSpot REST integration (optional when operating through ChatGPT connector)
HUBSPOT_ACCESS_TOKEN=

# Apollo REST integration (optional when operating through ChatGPT connector)
APOLLO_API_KEY=

# Dify workflow API
DIFY_API_KEY=
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_USER=free-ai-8

# Fish Audio — free developer model availability must be revalidated after 2026-08-31
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
FISH_VOICE_REFERENCE_ID=

# MiniMax — disabled unless ALLOW_PAID_AI=true
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_TEXT_MODEL=MiniMax-M2.7
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3-Fast

# Qoder GitHub Action secret name:
# QODER_PERSONAL_ACCESS_TOKEN
